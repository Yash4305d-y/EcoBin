<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Permits cleartext HTTP communication globally for local IoT microcontroller endpoints -->
    <!-- while preserving standard TLS trust anchors for HTTPS -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Explicitly declare local ESP8266/ESP32, SoftAP, and emulator domains -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.236.242.197</domain>
        <domain includeSubdomains="true">192.168.4.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
